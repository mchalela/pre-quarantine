# Never commit what strangers send, or converted copies of it.
QUARANTINE/*
!QUARANTINE/.gitkeep
CLEAN/*
!CLEAN/.gitkeep

# Active helper-agent rules. They are copies of agent/*, created by tools/install-agent-rules.sh
# in a working install only, so a development clone is never bound by them.
/CLAUDE.md
/.claude/
__pycache__/
.pytest_cache/

# Virtual environment of the optional MCP server.
.venv/

# What a run of the evals writes: transcripts and scores.
evals/results/
