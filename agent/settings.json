{
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/QUARANTINE/**",
    "**/CLEAN/**"
  ],
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Read(./QUARANTINE/**)",
      "Edit(./QUARANTINE/**)",
      "Edit(./tools/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./agent/**)",
      "Bash(./tools/q-shell.sh:*)",
      "Bash(tools/q-shell.sh:*)",
      "Bash(./tools/install-agent-rules.sh:*)",
      "Bash(tools/install-agent-rules.sh:*)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "mcp__*"
    ],
    "allow": [
      "Bash(./tools/q-inspect.sh:*)",
      "Bash(./tools/q-convert.sh:*)",
      "Bash(./tools/q-extract.sh:*)",
      "Bash(ls:*)",
      "Read(./CLEAN/**)"
    ]
  }
}
