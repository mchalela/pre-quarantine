#!/bin/sh
# Runs INSIDE the container. The untrusted file arrives on stdin; results go to /out.
# usage: q inspect|convert|extract [original-file-name]      env: Q_COLOR=1, Q_PATH, Q_DIR (shell-quoted host paths)
set -eu
cmd="${1:-}"; name="${2:-input}"
cat > /tmp/input
mime=$(file -b --mime-type /tmp/input)
ftype=$(file -b /tmp/input | cut -c1-160)

if [ "${Q_COLOR:-0}" = 1 ]; then
  R=$(printf '\033[1;31m'); G=$(printf '\033[1;32m'); Y=$(printf '\033[1;33m'); C=$(printf '\033[36m')
  B=$(printf '\033[1m'); D=$(printf '\033[2m'); N=$(printf '\033[0m')
else R=; G=; Y=; C=; B=; D=; N=; fi
clean() { sed 's/[[:cntrl:]]/?/g'; }                 # never let file contents drive the terminal
row() { printf '%s%-8s%s %s\n' "$B" "$1" "$N" "$2"; }

is_office() {
  case "$mime" in
    application/msword|application/vnd.ms-*|application/vnd.openxmlformats-*|application/vnd.oasis.opendocument.*|text/rtf|application/rtf) return 0 ;;
    application/zip|application/octet-stream)
      bsdtar -tf /tmp/input 2>/dev/null | grep -qE '^(word/|xl/|ppt/|\[Content_Types\]\.xml|content\.xml)' ;;
    *) return 1 ;;
  esac
}

# What the bytes really are.
category() {
  if head -c 400 /tmp/input | grep -aq '^\[Desktop Entry\]'; then echo launcher; return; fi
  if is_office; then echo office; return; fi
  case "$mime" in
    application/pdf) echo pdf ;;
    image/svg+xml|text/html|application/xhtml+xml) echo markup ;;
    image/png|image/jpeg|image/gif|image/bmp|image/tiff|image/webp) echo image ;;   # other image/* stay "unknown"
    application/x-executable|application/x-pie-executable|application/x-sharedlib|application/x-dosexec|application/x-mach-binary|application/vnd.debian.binary-package|application/x-rpm|application/x-msi|application/x-ms-shortcut|application/x-ms-installer|application/vnd.microsoft.portable-executable|application/java-archive|application/x-java-applet|application/vnd.appimage|application/x-iso9660-image) echo executable ;;
    application/zip|application/x-tar|application/gzip|application/x-7z-compressed|application/x-rar*|application/vnd.rar|application/x-xz|application/x-bzip2|application/zstd|application/x-lzip) echo archive ;;
    text/x-shellscript|application/x-shellscript|text/x-python|text/x-script.python|application/javascript|text/javascript|text/x-perl|text/x-ruby|text/x-php|text/x-java|text/x-c|text/x-c++|text/x-lua|text/x-msdos-batch) echo code ;;
    application/json|text/*|application/csv|inode/x-empty) echo text ;;
    *) echo unknown ;;
  esac
}

# What the name claims it is.
claimed() {
  ext=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -n 's/.*\.\([a-z0-9]*\)$/\1/p')
  case "$ext" in
    pdf) echo pdf ;;
    doc|docx|docm|xls|xlsx|xlsm|ppt|pptx|pptm|odt|ods|odp|rtf) echo office ;;
    png|jpg|jpeg|gif|bmp|tif|tiff|webp) echo image ;;
    svg|html|htm|xhtml) echo markup ;;
    zip|tar|gz|tgz|7z|rar|xz|bz2|zst) echo archive ;;
    txt|csv|json|md|log|yaml|yml|xml|tsv|ini|cfg|toml|tex|bib|rst) echo text ;;
    py|sh|js|ts|ipynb|rb|pl|php|c|cpp|h|java|go|rs|m|r|lua|bat|ps1) echo code ;;
    exe|msi|deb|rpm|appimage|jar|run|bin|dll|scr|com|apk|iso|dmg) echo executable ;;
    desktop|lnk|url) echo launcher ;;
    *) echo "" ;;
  esac
}

render_pdf() {  # $1 = pdf or image path
  mutool draw -r 110 -o /out/page-%03d.png "$1" 2>/tmp/err || { cat /tmp/err; echo "render failed"; exit 1; }
  mutool draw -F txt -o /out/text.txt "$1" 2>/dev/null || true
}

case "$cmd" in
  inspect)
    cat_real=$(category); cat_name=$(claimed)
    # file(1) often calls short scripts "plain text": trust a code extension over that.
    if [ "$cat_name" = code ] && [ "$cat_real" = text ]; then cat_real=code; fi
    verdict=OK; findings=""
    add() { findings="$findings  - $1
"; }
    raise() { case "$verdict:$1" in OK:*|CAUTION:STOP) verdict=$1 ;; esac; }

    row "file:"   "$(printf '%s' "$name" | clean)"
    row "type:"   "$(printf '%s' "$ftype" | clean)"
    row "mime:"   "$mime"
    row "size:"   "$(wc -c < /tmp/input) bytes"
    row "sha256:" "$D$(sha256sum /tmp/input | cut -d' ' -f1)$N"

    # 1. Does the name lie about the contents?  (ipynb/json/xml and friends are all "text" to file(1))
    if [ -n "$cat_name" ] && [ "$cat_name" != "$cat_real" ]; then
      case "$cat_name:$cat_real" in
        code:text|text:code|markup:text|text:markup|office:archive) : ;;
        *) raise STOP; add "name says ${cat_name}, contents are ${cat_real}: a disguised file" ;;
      esac
    fi
    case "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" in
      *.pdf.*|*.doc.*|*.docx.*|*.jpg.*|*.png.*|*.txt.*) raise STOP; add "double extension in the name" ;;
    esac

    # 2. Per type.
    case "$cat_real" in
      executable) raise STOP; add "this is a program or installer, not a document" ;;
      launcher)   raise STOP; add "launcher file: runs a command when opened" ;;
      pdf)
        mutool info /tmp/input 2>/dev/null | grep -E '^Pages:' | clean || true
        # Names can hide inside compressed object streams, so also scan an expanded copy.
        mutool clean -d /tmp/input /tmp/expanded.pdf >/dev/null 2>&1 || : > /tmp/expanded.pdf
        for k in /JavaScript /JS /OpenAction /AA /Launch /EmbeddedFile /RichMedia /XFA; do
          # Whole name only: "/AA" must not match a font called "/AAAAAA+Arial".
          a=$(grep -acE "$k([^A-Za-z0-9+]|\$)" /tmp/input || true)
          b=$(grep -acE "$k([^A-Za-z0-9+]|\$)" /tmp/expanded.pdf || true)
          n=$a; [ "$b" -gt "$n" ] && n=$b
          if [ "$n" -gt 0 ]; then raise CAUTION; add "PDF marker $k ($n)"; fi
        done
        n=$(grep -ac '/URI' /tmp/input || true); [ "$n" -gt 0 ] && row "links:" "$n (do not follow them)" || true
        grep -aq '/Encrypt' /tmp/input && { raise CAUTION; add "PDF is encrypted"; } || true ;;
      office)
        act=$(bsdtar -tf /tmp/input 2>/dev/null | grep -iE 'vbaProject|macros/|oleObject|activeX|\.bin$' | head -5 || true)
        if [ -n "$act" ]; then raise CAUTION; add "active content inside: $(printf '%s' "$act" | tr '\n' ' ' | clean)"; fi
        case "$mime" in *macroenabled*|*macroEnabled*) raise CAUTION; add "macro-enabled format" ;; esac
        if grep -aqE 'VBA|_VBA_PROJECT|Macros' /tmp/input 2>/dev/null && ! bsdtar -tf /tmp/input >/dev/null 2>&1; then
          raise CAUTION; add "legacy Office file that appears to contain macros"; fi
        if bsdtar -xOf /tmp/input '*.rels' 2>/dev/null | grep -aqiE 'TargetMode="External"[^>]*(attachedTemplate|oleObject|frame)|(attachedTemplate|oleObject|frame)[^>]*TargetMode="External"'; then
          raise CAUTION; add "loads a remote template or object"; fi ;;
      archive)
        if ! bsdtar -tf /tmp/input >/tmp/list 2>/tmp/lerr; then raise CAUTION; add "archive listing failed: $(head -1 /tmp/lerr | clean)"; fi
        bsdtar -xOf /tmp/input >/dev/null 2>/tmp/xerr || true
        if grep -qiE 'passphrase|encrypt|password' /tmp/xerr /tmp/lerr 2>/dev/null; then
          raise STOP; add "password-protected archive (the usual way to slip past scanners)"; fi
        total=$(wc -l < /tmp/list)
        row "entries:" "$total"
        bytes=$(bsdtar -tvf /tmp/input 2>/dev/null | awk '{s+=$5} END{printf "%.0f", s+0}')
        if [ "${bytes:-0}" -gt 2147483648 ]; then raise CAUTION; add "expands to $((bytes/1048576)) MB: possible decompression bomb"; fi
        bsdtar -tvf /tmp/input 2>/dev/null | head -40 | clean | sed "s/^/  $D/;s/\$/$N/"
        [ "$total" -gt 40 ] && echo "  $D... $((total-40)) more$N" || true
        bad=$(grep -iE '\.(exe|scr|bat|cmd|com|msi|dll|lnk|desktop|appimage|deb|rpm|vbs|jse|wsf|hta|ps1|jar|apk|dmg|iso)$' /tmp/list | head -5 || true)
        if [ -n "$bad" ]; then raise STOP; add "contains executables or launchers: $(printf '%s' "$bad" | tr '\n' ' ' | clean)"; fi
        if grep -qE '(^|/)\.\./|^/' /tmp/list; then raise STOP; add "paths that try to write outside the folder"; fi
        if grep -qiE '\.(py|js|ts|sh|ipynb|rb|php|go|rs)$|(^|/)(package\.json|setup\.py|pyproject\.toml|Makefile)$' /tmp/list; then
          raise CAUTION; add "contains code: after extracting, use the sandbox shell, never run on the host"; fi ;;
      markup) raise CAUTION; add "HTML/SVG can carry scripts: never open it in the browser" ;;
      code)   raise CAUTION; add "source code: read it, never run it on the host" ;;
      unknown) raise CAUTION; add "unrecognised file type" ;;
    esac

    echo
    if [ -n "$findings" ]; then printf '%s' "$findings" | sed "s/^/$Y/;s/\$/$N/"; echo; fi
    P="${Q_PATH:-<file>}"; DIR="${Q_DIR:-<folder>}"
    case "$verdict" in
      OK)      col=$G; msg="no known tricks found. Still, never open the original" ;;
      CAUTION) col=$Y; msg="suspicious content. Never open the original" ;;
      STOP)    col=$R; msg="dangerous file. Delete it and be wary of the sender" ;;
    esac
    printf '%sverdict:%s %s%s%s  %s\n' "$B" "$N" "$col" "$verdict" "$N" "$msg"
    if [ "$verdict" = STOP ]; then nxt="rm -- $P"
    else case "$cat_real" in
      pdf|office|image|text|markup) nxt="tools/q-convert.sh $P" ;;
      archive) nxt="tools/q-extract.sh $P" ;;
      code)    nxt="tools/q-shell.sh $DIR" ;;
      *)       nxt="ask the sender what this is; do not open it" ;;
    esac; fi
    printf '%snext:%s    %s%s%s\n' "$B" "$N" "$C" "$nxt" "$N" ;;
  convert)
    case "$mime" in
      application/pdf) render_pdf /tmp/input ;;
      image/png|image/jpeg|image/gif|image/tiff|image/bmp) render_pdf /tmp/input ;;
      image/svg+xml|application/json|text/*) head -c 5000000 /tmp/input > /out/content.txt ;;
      *)
        if is_office; then
          mkdir -p /tmp/lo
          soffice -env:UserInstallation=file:///tmp/lo-profile --headless --norestore \
            --convert-to pdf --outdir /tmp/lo /tmp/input >/tmp/lo.log 2>&1 || { cat /tmp/lo.log; exit 1; }
          render_pdf /tmp/lo/input.pdf
        else
          echo "Do not know how to convert '$mime'. Use q-inspect.sh, q-extract.sh or q-shell.sh."; exit 2
        fi ;;
    esac
    echo "ok: $(find /out -type f | wc -l) file(s) written" ;;
  extract)
    bsdtar -xf /tmp/input -C /out --no-same-owner --no-same-permissions 2>&1 | head -50
    find /out -type l -delete                       # no symlinks pointing out of quarantine
    find /out -type f -exec chmod 0644 {} +         # nothing is executable
    find /out -type d -exec chmod 0755 {} +
    echo "ok: $(find /out -type f | wc -l) file(s) extracted (symlinks removed, exec bits cleared)" ;;
  *) echo "usage: q inspect|convert|extract [name]  < file"; exit 2 ;;
esac
